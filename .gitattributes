# Store text as LF. Working tree is LF except Windows helper scripts.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.bin binary
*.o binary
*.a binary
*.so binary
*.dll binary
*.dylib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.jar binary
*.class binary
*.whl binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
