# ============================================================
# JGPT — 37 слоёв, SFT с нуля: vocab 16k, seq 2048 (~100.4M)
# Глубина, не ширина и не vocab 32k: +5 слоёв к 32L ≈ +12M весов,
# Adam +~140 МиБ, кэш активаций тот же (пул 2 блока).
# CUDA Graph off. Эффективный батч 128: batch=4 × accum=32, LR=1e-3.
# При OOM: JGPT_BATCH_SIZE=2 JGPT_ACCUMULATION_STEPS=64 (те же 128 окон)
#          или JGPT_MAX_SEQ_LEN=1536.
# ============================================================

export JGPT_STATS_PRESET="37L-sft-100M"
export JGPT_STATS_PRESET_IDX="37sft"

export JGPT_TRAIN_LOSS_MODE=sampled
export JGPT_CE_ASYNC=0
export JGPT_SAMPLED_CE_CANDIDATES=384

export JGPT_MAX_SEQ_LEN=2048
export JGPT_VOCAB_SIZE=16000
export JGPT_BATCH_SIZE=4
export JGPT_ACCUMULATION_STEPS=32
export JGPT_LEARNING_RATE=0.001

export JGPT_CHECKPOINT_SUBDIR="sft_37L_16k_2048"
export JGPT_TOKENIZER_PATH="checkpoints/tokenizer_sft_16k.bin"

export JGPT_INTERACTIVE_EVERY=0

export JGPT_FP16_AUX_SOFTEN=1
export JGPT_FP16_AUX_SOFTEN_EVAL=2
export JGPT_FP16_DYNAMIC_INITIAL=32768
export JGPT_FP16_DYNAMIC_MAX=65536
export JGPT_FP16_DYNAMIC_GROWTH_INTERVAL=50

export JGPT_SFT=1
export JGPT_SFT_CHAT_TEMPLATE=1
export JGPT_VAL_FRACTION=0.05
export JGPT_EARLY_STOP_EVAL_PATIENCE=0
export JGPT_EARLY_STOP_OVERFIT=0

export JGPT_PRESET_NUM_LAYERS=37

export JGPT_FLASH_ATTENTION=1
export JGPT_FA_TILE_SIZE=128
export JGPT_DECODER_LAYER_CUDA_GRAPH=0
export JGPT_BATCH_PREFETCH=1

export JGPT_CUDA_TRIM_EVERY_STEPS=0
export JGPT_VRAM_CLEANUP_EVERY_STEPS=0
export JGPT_FP16_MATMUL=1
export JGPT_FUSED_FFN_RMS_W1W3=1
export JGPT_FUSED_LM_HEAD=1
export JGPT_ACTIVATION_CACHE_FP16=1
export JGPT_BATCH_PINNED=1
export JGPT_BLOCK_CACHE_POOL=1
export JGPT_BLOCK_CACHE_GROW_ONLY=1
export JGPT_BLOCK_CACHE_POOL_MAX=2
export JGPT_BLOCK_CACHE_POOL_CLEANUP_INTERVAL=100

export JGPT_DEBUG_GPU_TRAIN=0
export JGPT_TRAIN_PERF=1
export JGPT_TIMINGS=0
export JGPT_PROFILE=0
export JGPT_DECODER_LAYER_CUDA_GRAPH_LOG=0
export JGPT_TRAIN_VRAM_STEP_PROBE=0
export JGPT_BWD_LAYER_FINITE_CHECK=0

export JGPT_SMART_STICKY_PRESET=1
